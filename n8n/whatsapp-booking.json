{
  "name": "WhatsApp Booking — Evolution API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "id": "a1b2c3d4-0001-0000-0000-000000000001",
      "name": "Receive WhatsApp Webhook",
      "webhookId": "whatsapp-booking"
    },
    {
      "parameters": {
        "jsCode": "// Parse an Evolution API messages.upsert payload.\n// Returns { skip, instanceName, from, text, fromMe, pushName }\nconst body = $input.first().json;\n\n// Only handle message events\nconst event = (body.event || '').toUpperCase();\nif (event && event !== 'MESSAGES_UPSERT' && event !== 'MESSAGES_UPDATE') {\n  return [{ json: { skip: true, reason: 'not a message event' } }];\n}\n\nconst instanceName = body.instance || body.instanceName || '';\nconst data = body.data || {};\nconst msgs = Array.isArray(data.messages)\n  ? data.messages\n  : (data.message ? [data] : (body.messages ? body.messages : []));\n\nif (!msgs.length) {\n  return [{ json: { skip: true, reason: 'no messages array' } }];\n}\n\nconst first = msgs[0];\nconst key = first.key || {};\nconst fromMe = key.fromMe === true;\n\n// Strip @s.whatsapp.net / @g.us suffix\nconst remoteJid = key.remoteJid || '';\nconst from = remoteJid.replace(/@[^@]+$/, '');\n\n// Extract text from various Evolution API message types\nconst msg = first.message || {};\nconst text =\n  msg.conversation ||\n  msg.extendedTextMessage?.text ||\n  msg.buttonsResponseMessage?.selectedDisplayText ||\n  msg.listResponseMessage?.singleSelectReply?.selectedRowId ||\n  '';\n\nconst pushName = first.pushName || null;\n\nif (!text) {\n  return [{ json: { skip: true, reason: 'no text content' } }];\n}\n\nreturn [{ json: { skip: false, instanceName, from, text, fromMe, pushName } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300],
      "id": "a1b2c3d4-0002-0000-0000-000000000001",
      "name": "Parse Payload"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "skip-true",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            },
            {
              "id": "from-me",
              "leftValue": "={{ $json.fromMe }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "or"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300],
      "id": "a1b2c3d4-0003-0000-0000-000000000001",
      "name": "Skip or fromMe?"
    },
