          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 450],
      "id": "a1b2c3d4-0007-0000-0000-000000000001",
      "name": "Context Valid?"
    },
    {
      "parameters": {
        "jsCode": "// Combine system prompt with conversation history.\n// History already includes the user's latest message (saved by /api/n8n/context).\n// We exclude the last entry (current turn) from the transcript and pass it as the\n// live prompt text so the AI Agent processes it as the active user input.\n\nconst ctx = $input.first().json;\nconst history = ctx.history || [];\n\n// All messages except the very last one form the prior conversation transcript\nconst prior = history.slice(0, -1);\n\nlet fullSystemPrompt = ctx.systemPrompt;\nif (prior.length > 0) {\n  const transcript = prior\n    .map((m) => `${m.role === 'user' ? 'Customer' : 'Assistant'}: ${m.content}`)\n    .join('\\n');\n  fullSystemPrompt += `\\n\\n## Conversation so far\\n${transcript}`;\n}\n\n// The current user message is the last history entry\nconst currentMessage = history[history.length - 1]?.content || ctx.currentMessage || '';\n\nreturn [{ json: { ...ctx, fullSystemPrompt, currentMessage } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 300],
      "id": "a1b2c3d4-0008-0000-0000-000000000001",
      "name": "Build Agent Context"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.currentMessage }}",
        "options": {
          "systemMessage": "={{ $json.fullSystemPrompt }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [1750, 300],
      "id": "a1b2c3d4-0009-0000-0000-000000000001",
      "name": "AI Booking Agent"
    },
