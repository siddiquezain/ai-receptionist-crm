          "maxTokens": "={{ $('Build Agent Context').item.json.aiMaxTokens ?? 1000 }}"
        }
      },
      "credentials": {
        "openAiApi": { "id": "openai-creds", "name": "OpenAI account" }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1500, 100],
      "id": "a1b2c3d4-0010-0000-0000-000000000001",
      "name": "OpenAI Chat Model"
    },
    {
