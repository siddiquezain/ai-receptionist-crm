# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL and anon key (safe to expose — these are public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key — server-only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string — use the PgBouncer pooled URL for Prisma
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM (encrypts BYOK API keys at rest)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-string

# ── AI Providers (platform-level keys, optional) ──────────────────────────────
# Used when a tenant has not configured their own BYOK key.
# Tenants can override these with their own keys via Settings → AI.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...
GROK_API_KEY=xai-...

# ── n8n Integration (Phase 4) ─────────────────────────────────────────────────
# Shared secret for verifying HMAC signatures on incoming n8n webhooks
N8N_WEBHOOK_SECRET=your-webhook-secret

# Internal API key used by n8n to authenticate calls to /api/internal/*
N8N_API_KEY=your-internal-api-key

# ── Evolution API / WhatsApp (Phase 4) ────────────────────────────────────────
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=your-evolution-api-key
