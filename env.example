# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://..."

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Service role key — used by n8n staff-reply workflow to write to Supabase directly
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─── Evolution API ───────────────────────────────────────────────────────────
# Default server URL for all tenants (overridable per tenant in Settings → WhatsApp)
EVOLUTION_API_URL="https://your-evolution-instance.com"
# Optional: shared secret Evolution API includes in the "apikey" header on webhooks
# Protects the /api/whatsapp/webhook fallback shim (not needed when n8n handles the webhook)
EVOLUTION_WEBHOOK_SECRET=""

# ─── n8n integration ─────────────────────────────────────────────────────────
# Shared secret for requests FROM n8n → Next.js  (set in both places)
N8N_INTERNAL_SECRET="generate-a-strong-random-secret"

# n8n webhook URLs — set each once the matching n8n workflow is active.
# Until set, Next.js falls back to its built-in implementation.

# Web Chat AI flow  (n8n/web-chat.json)
# Next.js POST → n8n, n8n returns { reply, conversationId }
N8N_CHAT_WEBHOOK_URL=""

# Staff reply delivery  (n8n/staff-reply.json)
# Next.js POST → n8n, n8n sends via Evolution API + saves to Supabase
N8N_REPLY_WEBHOOK_URL=""

# WhatsApp incoming forward — only needed when Next.js acts as a thin proxy.
# In production, configure Evolution API to send webhooks directly to n8n and
# leave this blank (Next.js won't be in the WhatsApp message path at all).
N8N_WHATSAPP_WEBHOOK_URL=""

# ─── AI providers ────────────────────────────────────────────────────────────
# Default keys used when a tenant has not set a BYOK key in AI Settings
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
GROK_API_KEY=""

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=""
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=""

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Your Business <noreply@yourdomain.com>"

# ─── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cron (Vercel) ────────────────────────────────────────────────────────────
# Protects /api/notifications/process — must match the value in vercel.json cron config
CRON_SECRET=""
